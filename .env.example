# Local dev works with embedded PostgreSQL; set DATABASE_URL for hosted Postgres.
PORT=3001
HOST=127.0.0.1
DATABASE_URL=
# Optional override of the bundled public Supabase root CA.
DATABASE_CA_CERT_PATH=
PGLITE_DIR=.data/verdant
# Local-only authentication. Production refuses this mode.
LOCAL_DEMO_AUTH=true
LOCAL_AGENT_EMAIL=agent@verdant.example
LOCAL_AGENT_PASSWORD=verdant-local-2026
# Required for production cookie signing: generate at least 32 random characters.
SESSION_SECRET=
WEBHOOK_SECRET=verdant-demo-secret-2026
# Hosted agent authentication (Supabase); never expose the service-role key.
SUPABASE_URL=
# Preferred current key names; legacy aliases below are also accepted.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI-compatible chat completion endpoint. Supply a real provider/model/key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Optional comma-separated models, tried only after retryable OpenRouter errors.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_MS=25000
WORKER_ENABLED=true
# Server-side Supabase Realtime bridge uses the provisioned agent credentials.
REALTIME_ENABLED=true
AGENT_EMAIL=
AGENT_PASSWORD=
